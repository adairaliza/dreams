---

<article id="dream-container"></article>

<style>
    article {
        pointer-events: none;
        position: absolute;
        height: 100%;
        width: 100%;
        top: 0;
        overflow: hidden;

        div {
            pointer-events: auto;
            position: absolute;
            max-width: 20%;
            max-height: 30%;
            overflow-y: scroll;
            top: 0%;
            animation: fallingStar 25s linear forwards;
        }

        div:hover {
            animation-play-state: paused;
        }

        h2 {
            pointer-events: auto;
            position: relative;
        }

        h2::before {
            content: "☆";
            display: flex;
        }

        h2::after {
            content: var(--dream-description, "");
            display: none;
        }

        h2:hover::before {
            display: none;
        }

        h2:hover::after {
            display: block;
        }

        p {
            text-align: right;
        }
    }

    @keyframes fallingStar {
        0% {
            transform: translateY(-5vh);
        }
        100% {
            transform: translateY(115vh);
        }
    }
</style>

<script>
    let foundDreams: any[] = [];

    const collectionCall = await fetch("/api/dreamsSize");
    if (!collectionCall.ok) throw new Error("Failed to fetch collection");
    const collectionSize = await collectionCall.json();

    async function getDream() {
        try {
            if (foundDreams.length === collectionSize.count) foundDreams = [];

            let dream;
            let dreamCheck = false;

            while (!dreamCheck) {
                const response = await fetch("/api/dreams");
                if (!response.ok) throw new Error("Failed to fetch dream");

                dream = await response.json();

                if (!dream) return;

                if (!foundDreams.includes(dream._id)) {
                    foundDreams.push(dream._id);
                    dreamCheck = true;
                }
            }

            const dreamDiv = document.createElement("div");
            dreamDiv.style.left = `${Math.floor(Math.random() * 90 + 5)}vh`;

            const description = document.createElement("h2");
            description.style.setProperty(
                "--dream-description",
                `"${dream?.description}"`,
            );

            const date = document.createElement("p");
            date.textContent = new Date(dream?.date).toDateString();

            dreamDiv.append(description, date);

            document.getElementById("dream-container")?.appendChild(dreamDiv);
        } catch (error) {
            console.log("~~ERROR IN DREAM CONTAINER SCRIPT~~");
            console.error(error);
        }
    }

    getDream();

    setInterval(getDream, 5000);
</script>
